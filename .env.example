# Скопируйте в .env и при необходимости поменяйте значения.

# --- PostgreSQL ---
POSTGRES_DB=itis
POSTGRES_USER=itis
POSTGRES_PASSWORD=itis

# Порт БД на хосте (5432 может быть занят локальным postgres)
DB_PORT=5432

# --- Приложение ---
APP_PORT=8080

JWT_SECRET=
AUTH_ORIGIN=
AUTH_COOKIE_SECURE=false
