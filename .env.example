# Пример окружения. Скопируй в .env и заполни своими значениями.
# .env в git НЕ попадает (см. .gitignore), секреты живут только локально/в CI.

# --- Приложение ---
APP_NAME=Сайт кафедры ВТИСиТ
APP_VERSION=0.1.0
ENVIRONMENT=local            # local | docker | ci | prod

# --- Будущая БД (задача 05) ---
# DATABASE_URL=postgresql+psycopg://itis:itis@db:5432/itis
DATABASE_URL=sqlite:///./itis.db

# --- Авторизация (задача 06) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60
